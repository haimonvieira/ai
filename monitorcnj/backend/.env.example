# ===========================================
# MONITORCNJ - Variáveis de Ambiente
# ===========================================
# Todas as variáveis são OPCIONAIS para teste local.
# Para produção, configure os serviços gratuitos indicados.

# ===========================================
# SERVIDOR
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# SEGURANÇA (JWT)
# ===========================================
# Gere um segredo forte em produção: openssl rand -hex 32
JWT_SECRET=monitorcnj-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# BANCO DE DADOS - Neon.tech (PostgreSQL Free Tier)
# ===========================================
# Obtenha em: https://neon.tech
# Free tier: 0.5 GB storage, limites generosos
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/monitorcnj?sslmode=require"

# ===========================================
# CACHE - Upstash Redis (Free Tier)
# ===========================================
# Obtenha em: https://upstash.com
# Free tier: 10k comandos/dia, 256MB
UPSTASH_REDIS_REST_URL="https://xyz.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_redis_token"

# ===========================================
# IA - GROQ (Principal - Llama 3.3 70B)
# ===========================================
# Obtenha em: https://console.groq.com
# Free tier: ~30 req/min, 14400 req/dia (varia)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# ===========================================
# IA - GOOGLE GEMINI FLASH (Fallback Multimodal)
# ===========================================
# Obtenha em: https://aistudio.google.com/apikey
# Free tier: 15 req/min, 1M tokens/min, 1500 req/dia
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# ===========================================
# IA - SILICONFLOW (Backup - Qwen3-8B)
# ===========================================
# Obtenha em: https://cloud.siliconflow.cn
# Free tier: limites variados por modelo
SILICONFLOW_API_KEY="your_siliconflow_key_here"
SILICONFLOW_MODEL="Qwen/Qwen2.5-7B-Instruct"

# ===========================================
# CNJ API
# ===========================================
# API pública, não requer autenticação
CNJ_API_BASE_URL=https://api-publica.datajud.cnj.jus.br

# ===========================================
# RATE LIMITING (Proteção Free Tier)
# ===========================================
# Limites conservadores para não estourar free tiers
RATE_LIMIT_WINDOW_MS=86400000
RATE_LIMIT_MAX_REQUESTS_GROQ=100
RATE_LIMIT_MAX_REQUESTS_GEMINI=100
RATE_LIMIT_MAX_REQUESTS_SILICONFLOW=100

# ===========================================
# CACHE CONFIG
# ===========================================
CACHE_TTL_SECONDS=7200
CACHE_ENABLED=true

# ===========================================
# LOGS & AUDITORIA (LGPD)
# ===========================================
# Nunca logar conteúdo sensível de petições
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
